[Unit]
Description=Abu Dhabi E-Ink Display Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=display
Group=display
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/ad-eink-display
ExecStart=/opt/abu-dhabi-eink/run-display-current.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
