[Unit]
Description=Abu Dhabi E-Ink Display Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/ad-eink-display
RuntimeDirectory=abu-dhabi-eink
RuntimeDirectoryMode=0755
ExecStart=/opt/abu-dhabi-eink/run-display-current.sh
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
